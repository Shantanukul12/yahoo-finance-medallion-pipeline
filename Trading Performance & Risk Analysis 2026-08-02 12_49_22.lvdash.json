{
  "datasets": [
    {
      "name": "dataset1",
      "displayName": "Stock Performance Metrics",
      "config": {
        "version": "1.1",
        "source": "stock_exchange_api_catalog.gold.gold_summary",
        "dimensions": [
          {
            "name": "symbol",
            "expr": "symbol"
          },
          {
            "name": "exchange",
            "expr": "exchange"
          },
          {
            "name": "currency",
            "expr": "currency"
          },
          {
            "name": "trading_minutes",
            "expr": "trading_minutes"
          }
        ],
        "measures": [
          {
            "name": "current_price",
            "expr": "SUM(current_price)",
            "displayName": "Current Price"
          },
          {
            "name": "avg_price",
            "expr": "SUM(avg_price)",
            "displayName": "Average Price"
          },
          {
            "name": "min_price",
            "expr": "SUM(min_price)",
            "displayName": "Min Price"
          },
          {
            "name": "max_price",
            "expr": "SUM(max_price)",
            "displayName": "Max Price"
          },
          {
            "name": "price_range",
            "expr": "SUM(max_price - min_price)",
            "displayName": "Price Range",
            "comment": "Difference between max and min price"
          },
          {
            "name": "price_change_pct",
            "expr": "SUM((current_price - avg_price) / avg_price * 100)",
            "displayName": "Price Change %",
            "comment": "Percentage change from average to current price"
          },
          {
            "name": "volatility",
            "expr": "SUM(volatility)",
            "displayName": "Volatility"
          },
          {
            "name": "total_volume",
            "expr": "SUM(total_volume)",
            "displayName": "Total Volume"
          },
          {
            "name": "avg_volume",
            "expr": "SUM(avg_volume)",
            "displayName": "Average Volume"
          },
          {
            "name": "volume_per_minute",
            "expr": "SUM(total_volume / trading_minutes)",
            "displayName": "Volume Per Minute",
            "comment": "Average trading volume per minute"
          },
          {
            "name": "turnover_ratio",
            "expr": "SUM(turnover_ratio)",
            "displayName": "Turnover Ratio"
          },
          {
            "name": "market_value",
            "expr": "SUM(current_price * total_volume)",
            "displayName": "Market Value",
            "comment": "Total market value traded"
          },
          {
            "name": "count",
            "expr": "COUNT(*)",
            "displayName": "Count"
          }
        ]
      }
    }
  ],
  "pages": [
    {
      "name": "page1",
      "displayName": "New Page",
      "layout": [
        {
          "widget": {
